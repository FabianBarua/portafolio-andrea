      .tool::after {
        content: "↗";
        justify-self: end;
        color: var(--signal-dark);
        font-size: 0.48em;
        opacity: 0;
        transform: translate(-15px, 15px);
        transition:
          opacity 220ms ease,
          transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .tool:hover {
        padding-right: 18px;
        padding-left: 18px;
        color: var(--signal-dark);
      }

      .tool:hover::after {
        opacity: 1;
        transform: translate(0, 0);
      }

      .tool-number {
        padding-top: 0;
        color: var(--muted);
        font-weight: 700;
      }

      /* CONTACT */

      .contact {
        position: relative;
        isolation: isolate;
        min-height: max(700px, 100svh);
        padding: clamp(120px, 11vw, 180px) var(--gutter) 48px;
        overflow: clip;
        background: #0b0b0a;
      }

      .contact-heading h2 {
        max-width: 11ch;
        margin-top: clamp(55px, 7vw, 105px);
        font-size: clamp(78px, 11.8vw, 190px);
        line-height: 0.75;
        letter-spacing: -0.08em;
      }

      .contact-heading em {
        color: var(--signal);
        font-style: italic;
      }

      .contact-bottom {
        padding-top: 42px;
        border-top: 1px solid #33312e;
      }

      .contact-bottom p {
        color: #7f7b75;
        font-size: 13px;
        letter-spacing: 0.02em;
      }

      .contact-links {
        min-width: min(100%, 390px);
        gap: 0;
      }

      .contact-links a {
        width: 100%;
        padding: 12px 0;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid #2e2c29;
        font-size: clamp(24px, 2.1vw, 34px);
        transition:
          color 180ms ease,
          padding 250ms ease;
      }

      .contact-links a:hover {
        padding-left: 12px;
        color: var(--signal);
        opacity: 1;
      }

      footer {
        padding: 28px var(--gutter);
        background: #0b0b0a;
        border-top-color: #272522;
        color: #6f6b65;
        font-weight: 650;
      }

      footer a {
        color: var(--paper);
      }

      /* MOTION */

      /* RESPONSIVE / TABLET */

      @media (max-width: 1100px) {
        .hero h1 {
          font-size: clamp(82px, 13.8vw, 152px);
        }

        .about-main {
          grid-template-columns: 1fr;
        }

        .about-info {
          max-width: 760px;
          margin: 20px 0 0 auto;
        }
      }

      /* RESPONSIVE / MOBILE */

      @media (max-width: 850px) {
        :global(:root) {
          --gutter: 20px;
        }

        .nav {
          height: 70px;
          padding-right: max(var(--gutter), env(safe-area-inset-right));
          padding-left: max(var(--gutter), env(safe-area-inset-left));
        }

        .logo {
          grid-template-columns: 1fr;
          gap: 0;
          font-size: 11px;
          line-height: 0.95;
        }

        .nav-links a:last-child {
          min-height: 38px;
          padding: 0 15px;
          border: 0;
          font-size: 10px;
        }

        .hero {
          min-height: max(720px, 100svh);
          padding: 100px calc(var(--gutter) + var(--hero-inner)) 28px;
          background: var(--paper);
        }

        .hero-top {
          grid-template-columns: 1fr 1.4fr;
          gap: 18px;
          line-height: 1.35;
        }

        .hero-location {
          display: none;
        }

        .availability {
          text-align: right;
        }

        .hero-title {
          min-height: 0;
          padding: clamp(82px, 17svh, 132px) 0 clamp(74px, 14svh, 112px);
        }

        .hero-title::after {
          top: 53%;
          right: 3%;
          width: clamp(74px, 22vw, 120px);
        }

        .hero h1 {
          font-size: clamp(60px, 20.4vw, 118px);
          line-height: 0.75;
        }

        .hero h1 span {
          margin-top: 0.18em;
          margin-left: 0;
        }

        .hero-bottom {
          grid-template-columns: 1fr;
          gap: 28px;
          padding-top: 22px;
        }

        .hero-description {
          font-size: clamp(19px, 5.2vw, 25px);
        }

        .hero-meta {
          justify-content: flex-start;
        }

        .scroll {
          margin-top: 30px;
          padding-top: 18px;
          border-top: 1px solid var(--line);
        }

        .projects,
        .experience,
        .tools {
          padding: 110px var(--gutter);
        }

        .projects {
          padding-top: 76px;
          padding-bottom: 82px;
        }

        .projects::before {
          right: var(--gutter);
        }

        .section-header {
          grid-template-columns: 1fr;
          gap: 30px;
          margin-bottom: 48px;
        }

        .section-header h2 {
          font-size: clamp(46px, 12vw, 64px);
          line-height: 0.87;
        }

        .section-intro {
          max-width: 34rem;
        }

        .projects-grid {
          grid-template-columns: 1fr;
          row-gap: 48px;
        }

        .project-card:nth-child(n) {
          grid-column: 1;
          margin-top: 0;
        }

        .project-card:nth-child(n) .project-image {
          aspect-ratio: 4 / 3;
        }

        .project-info {
          gap: 18px;
        }

        .project-info h3 {
          font-size: clamp(22px, 6.8vw, 31px);
        }

        .drive-badge {
          max-width: calc(100% - 76px);
          white-space: nowrap;
          opacity: 1;
          transform: none;
        }

        .experience-content {
          grid-template-columns: 1fr;
          gap: 0;
        }

        .experience-title h2 {
          margin-bottom: 90px;
          font-size: clamp(49px, 13.5vw, 76px);
        }

        .experience-item {
          padding-left: 48px;
        }

        .about {
          padding: 110px var(--gutter) 0;
        }

        .about-top {
          padding-bottom: 64px;
        }

        .about-main {
          gap: 65px;
          padding-top: 62px;
        }

        .about-title h2 {
          font-size: clamp(52px, 16vw, 88px);
        }

        .about-info {
          margin-top: 0;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .stat {
          min-height: 170px;
        }

        .tools-header {
          gap: 28px;
        }

        .tool {
          grid-template-columns: 48px 1fr;
          min-height: 88px;
          font-size: clamp(27px, 8vw, 43px);
        }

        .tool::after {
          display: none;
        }

        .tool:hover {
          padding-right: 0;
          padding-left: 0;
        }

        .contact {
          min-height: max(660px, 100svh);
          padding: 108px var(--gutter) 30px;
        }

        .contact-heading h2 {
          max-width: 100%;
          margin-top: clamp(60px, 12svh, 96px);
          font-size: clamp(54px, 15.5vw, 92px);
          line-height: 0.8;
        }

        .contact-bottom {
          gap: 34px;
          padding-top: 32px;
        }

        .contact-links {
          width: 100%;
          min-width: 0;
        }

        .contact-links a {
          min-height: 58px;
          align-items: center;
          font-size: clamp(22px, 6.3vw, 30px);
        }

        footer {
          padding: 28px var(--gutter);
        }
      }

      @media (max-width: 520px) {
        .hero h1 {
          font-size: clamp(57px, 19.8vw, 82px);
        }

        .hero-meta span {
          padding: 7px 10px;
          font-size: 8px;
        }

        .project-description {
          font-size: 13px;
        }

        .experience-item {
          padding: 0 0 72px 42px;
        }

        .experience-data h3 {
          font-size: clamp(32px, 10vw, 42px);
        }

        .about-columns {
          grid-template-columns: 1fr;
        }

        .stats {
          grid-template-columns: 1fr 1fr;
        }

        .stat {
          min-height: 146px;
          padding: 18px 12px;
        }

        .stat:nth-child(odd) {
          padding-left: 0;
        }

        .stat-value {
          font-size: clamp(42px, 14vw, 62px);
        }

        .contact-heading h2 {
          font-size: clamp(50px, 15vw, 76px);
        }

        footer {
          gap: 18px;
        }
      }

      @media (max-width: 360px) {
        :global(:root) {
          --gutter: 16px;
        }

        .hero h1 {
          font-size: clamp(53px, 19.2vw, 66px);
        }

        .hero-title::after {
          width: 70px;
        }

        .section-header h2 {
          font-size: 47px;
        }

        .drive-badge {
          padding: 9px;
          font-size: 7.5px;
        }

        .about-title h2 {
          font-size: 48px;
        }

        .tool {
          grid-template-columns: 38px 1fr;
          font-size: 25px;
        }

        .contact-heading h2 {
          font-size: 46px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) {
          scroll-behavior: auto;
        }

        .hero-top,
        .hero-title,
        .hero-bottom,
        .scroll {
          animation: none;
        }

        .project-image img,
        .tool,
        .tool::after,
        .contact-links a {
          transition: none;
        }
      }
    </style>

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
