---
const projects = [
  {
    number: "01",
    title: "OPPO — Retail & After Sales",
    category: "Retail · Environmental Graphics · POS",
    description:
      "Aplicaciones de marca, mesas, columnas, gigantografías y comunicación para puntos de venta en Paraguay, Brasil y Uruguay.",
    image: "/img/portfolio/oppo-retail.webp",
    link: "https://drive.google.com/drive/folders/1eIHWetpeDGS4VimLOQVsj2Dv4O6C2W9q?usp=sharing",
  },
  {
    number: "02",
    title: "OPPO — Product Campaigns",
    category: "Campaign · Product Communication",
    description:
      "Key visuals y comunicación de producto para Reno Series y otros lanzamientos, adaptados a diferentes necesidades comerciales.",
    image: "/img/portfolio/oppo-product.webp",
    link: "https://drive.google.com/drive/folders/1ynJbfmu6Oq-LRl9KSejJhp-QSbPcZC1s?usp=sharing",
  },
  {
    number: "03",
    title: "OPPO — Events & Experiences",
    category: "Events · Launches · Experiences",
    description:
      "Piezas para lanzamientos, aperturas, invitaciones y experiencias de marca.",
    image: "/img/portfolio/oppo-events.webp",
    link: "https://drive.google.com/drive/folders/1dEqpoxZDfrHSYcuvBM_0td61rKQDKQn_?usp=sharing",
  },
  {
    number: "04",
    title: "OPPO — Digital & Social",
    category: "Social Media · Digital",
    description:
      "Contenido para feed, stories, campañas estacionales y piezas digitales manteniendo consistencia de marca.",
    image: "/img/portfolio/oppo-digital.webp",
    link: "https://drive.google.com/drive/folders/1YnbPdvZqMqZxayeFb_gVKH50LNzTivbA?usp=sharing",
  },
  {
    number: "05",
    title: "OPPO — Print & POP",
    category: "Print · POP · Large Format",
    description:
      "Folletos, cartelería promocional, roll-ups y materiales impresos preparados para producción.",
    image: "/img/portfolio/oppo-print.webp",
    link: "https://drive.google.com/drive/folders/1UzEkTB4xKrVXeaYe_HRUOdFjRmvc640n?usp=sharing",
  },
  {
    number: "06",
    title: "OPPO — Video & Motion",
    category: "Video · Motion · Content",
    description:
      "Selección de piezas audiovisuales y contenido en movimiento para comunicación de producto.",
    image: "/img/portfolio/oppo-video.webp",
    link: "https://drive.google.com/drive/folders/1R8fLGGuNQDRj6vvxV4ZLMbq5lye6JuV-?usp=sharing",
  },
];

const tools = [
  "Adobe Photoshop",
  "Adobe Illustrator",
  "CorelDRAW",
  "Adobe Premiere Pro",
  "After Effects",
  "Canva",
  "CapCut",
];

const stats = [
  { value: "05+", label: "Años de experiencia" },
  { value: "PY", label: "Paraguay" },
  { value: "ES / EN", label: "Idiomas" },
  { value: "360°", label: "Digital · Print · Retail" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Portafolio de Andrea Aguayo, diseñadora gráfica especializada en publicidad, retail, social media y comunicación visual."
    />
    <title>Andrea Aguayo — Diseñadora Gráfica</title>
  </head>

  <body>
    <header class="nav">
      <a href="#inicio" class="logo" aria-label="Andrea Aguayo — Inicio">
        <span>ANDREA</span>
        <span>AGUAYO</span>
      </a>

      <nav class="nav-links">
        <a href="#proyectos">Proyectos</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <section class="hero" id="inicio">
        <div class="hero-top">
          <span>PORTFOLIO / 2026</span>
          <span class="hero-location">CIUDAD DEL ESTE / PARAGUAY</span>
          <span class="availability">Diseño gráfico & comunicación visual</span>
        </div>

        <div class="hero-title">
          <h1>
            GRAPHIC
            <span>DESIGNER.</span>
          </h1>
        </div>

        <div class="hero-bottom">
          <p class="hero-description">
            Diseño campañas, piezas digitales y materiales para espacios
            comerciales combinando creatividad, funcionalidad y consistencia de
            marca.
          </p>

          <div class="hero-meta">
            <span>Advertising</span>
            <span>Social Media</span>
            <span>Retail</span>
            <span>Print & POP</span>
          </div>
        </div>

        <a class="scroll" href="#proyectos">VER PROYECTOS ↓</a>
      </section>

      <section class="projects" id="proyectos">
        <div class="section-header">
          <div>
            <span class="eyebrow">01 / SELECTED WORK</span>
            <h2>Trabajo<br />seleccionado.</h2>
          </div>

          <div class="section-intro">
            <p>
              Una selección de algunos proyectos. Cada tarjeta abre la carpeta
              correspondiente con material adicional y aplicaciones reales.
            </p>
            <span>PREVIEW EN WEB · PROYECTO COMPLETO EN DRIVE</span>
          </div>
        </div>

        <div class="projects-grid">
          {
            projects.map((project) => (
              <a
                class="project-card"
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Abrir ${project.title} en Google Drive`}
              >
                <div class="project-image">
                  <img src={project.image} alt={project.title} loading="lazy" />

                  <div class="project-number">{project.number}</div>

                  <div class="drive-badge">VER PROYECTO COMPLETO ↗</div>
                </div>

                <div class="project-info">
                  <div>
                    <h3>{project.title}</h3>
                    <p class="project-category">{project.category}</p>
                    <p class="project-description">{project.description}</p>
                  </div>

                  <span class="project-arrow">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="experience" id="experiencia">
        <div class="section-label">
          <span class="eyebrow">02 / EXPERIENCIA</span>
        </div>

        <div class="experience-content">
          <div class="experience-title">
            <h2>Diseño aplicado a marcas y experiencias reales.</h2>
          </div>

          <div class="experience-list">
            <article class="experience-item">
              <div class="experience-year">ACTUALIDAD</div>

              <div class="experience-data">
                <h3>OPPO Paraguay</h3>
                <span>Diseñadora Gráfica</span>

                <p>
                  Desarrollo de comunicación visual para campañas, lanzamientos,
                  redes sociales, puntos de venta, eventos y materiales
                  comerciales.
                </p>

                <ul>
                  <li>Campañas y lanzamientos de smartphones</li>
                  <li>Material para retail y puntos de venta</li>
                  <li>Gigantografías, cartelería, ploteos y material POP</li>
                  <li>Contenido digital y social media</li>
                  <li>Eventos, invitaciones y experiencias de marca</li>
                  <li>Adaptación de artes a múltiples medidas y mercados</li>
                  <li>Edición y composición de imágenes</li>
                  <li>Contenido audiovisual y motion</li>
                  <li>Aplicación de lineamientos y manuales de marca</li>
                </ul>
              </div>
            </article>

            <article class="experience-item last">
              <div class="experience-year">EXPERIENCIA ANTERIOR</div>

              <div class="experience-data">
                <h3>Lucky Import</h3>
                <span>Diseñadora Gráfica</span>

                <p>
                  Experiencia desarrollando carteles, contenido para redes
                  sociales, material publicitario, impresión y comunicación
                  visual.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="about" id="sobre-mi">
        <div class="about-top">
          <span class="eyebrow">03 / SOBRE MÍ</span>
        </div>

        <div class="about-main">
          <div class="about-title">
            <h2>
              Diseño para
              <em>comunicar.</em>
              No solamente
              <span>para decorar.</span>
            </h2>
          </div>

          <div class="about-info">
            <p class="about-lead">
              Soy Andrea Aguayo, diseñadora gráfica con más de cinco años de
              experiencia en comunicación visual, publicidad, medios digitales,
              impresión y retail.
            </p>

            <div class="about-columns">
              <p>
                Actualmente desarrollo materiales gráficos para OPPO Paraguay,
                trabajando en campañas, lanzamientos, puntos de venta, eventos y
                contenidos digitales.
              </p>

              <p>
                Mi enfoque combina creatividad con funcionalidad: cada pieza
                debe responder a un objetivo, respetar la identidad de marca y
                funcionar correctamente en el medio para el que fue creada.
              </p>
            </div>
          </div>
        </div>

        <div class="stats">
          {
            stats.map((stat) => (
              <div class="stat">
                <span class="stat-value">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="tools">
        <div class="tools-header">
          <span class="eyebrow">04 / HERRAMIENTAS</span>

          <p>Herramientas que forman parte de mi flujo de trabajo.</p>
        </div>

        <div class="tools-list">
          {
            tools.map((tool, index) => (
              <div class="tool">
                <span class="tool-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="tool-name">{tool}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="contact" id="contacto">
        <div class="contact-heading">
          <span class="eyebrow">05 / CONTACTO</span>

          <h2>
            ¿Trabajamos
            <em>juntos?</em>
          </h2>
        </div>

        <div class="contact-bottom">
          <p>Diseño gráfico · Publicidad · Social Media · Retail · Print</p>

          <div class="contact-links">
            <a
              href="https://wa.me/595975568374"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp ↗
            </a>

            <a href="mailto:andreaagua41@gmail.com">Email ↗</a>
            <a
              href="https://drive.google.com/drive/folders/1E73Qdszgvt2Vk2WhMiJLWm6koNUEA6vr?usp=sharing"
              target="_blank"
              rel="noopener noreferrer"
            >
              Descargar CV ↗
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>© 2026 ANDREA AGUAYO</span>
      <a href="#inicio">VOLVER ARRIBA ↑</a>
    </footer>

    <style>
      :global(*) {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        background: #f7f4fc;
        color: #111;
        font-family: Inter, Arial, Helvetica, sans-serif;
        overflow-x: hidden;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :global(img) {
        display: block;
        width: 100%;
      }

      .eyebrow {
        font-size: 11px;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      /* NAV */

      .nav {
        position: fixed;
        inset: 0 0 auto 0;
        height: 78px;
        padding: 0 3vw;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        background: rgba(243, 243, 239, 0.88);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      }

      .logo {
        font-weight: 700;
        font-size: 14px;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        gap: 32px;
        font-size: 13px;
      }

      .nav-links a {
        position: relative;
      }

      .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -5px;
        width: 0;
        height: 1px;
        background: #111;
        transition: width 0.3s ease;
      }

      .nav-links a:hover::after {
        width: 100%;
      }

      /* HERO */

      .hero {
        min-height: 100vh;
        padding: 125px 3vw 45px;
        display: flex;
        flex-direction: column;
      }

      .hero-top {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .availability {
        display: flex;
        gap: 8px;
        align-items: center;
      }

      .availability::before {
        content: "";
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ee36c;
      }

      .hero-title {
        flex: 1;
        display: flex;
        align-items: center;
      }

      .hero h1 {
        font-size: clamp(80px, 14.3vw, 230px);
        line-height: 0.78;
        letter-spacing: -0.085em;
        font-weight: 700;
      }

      .hero h1 span {
        display: block;
        font-weight: 300;
      }

      .hero-bottom {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: end;
      }

      .hero-description {
        max-width: 580px;
        font-size: clamp(20px, 2vw, 31px);
        line-height: 1.3;
        letter-spacing: -0.035em;
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
      }

      .hero-meta span {
        padding: 9px 15px;
        border: 1px solid #bbb;
        border-radius: 100px;
        font-size: 11px;
        text-transform: uppercase;
      }

      .scroll {
        margin-top: 45px;
        width: max-content;
        font-size: 11px;
        letter-spacing: 0.08em;
      }

      /* PROJECTS */

      .projects {
        padding: 160px 3vw 140px;
        background: #111;
        color: #f4f4f0;
      }

      .section-header {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 50px;
        margin-bottom: 100px;
      }

      .section-header h2 {
        margin-top: 25px;
        font-size: clamp(65px, 8vw, 130px);
        line-height: 0.9;
        letter-spacing: -0.065em;
        font-weight: 400;
      }

      .section-intro {
        max-width: 430px;
        align-self: end;
      }

      .section-intro p {
        font-size: 18px;
        line-height: 1.55;
        color: #aaa;
      }

      .section-intro span {
        display: block;
        margin-top: 24px;
        font-size: 10px;
        letter-spacing: 0.09em;
        color: #666;
      }

      .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 95px 24px;
      }

      .project-card {
        display: block;
      }

      .project-image {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: #222;
      }

      .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
      }

      .project-card:hover .project-image img {
        transform: scale(1.035);
      }

      .project-number {
        position: absolute;
        top: 18px;
        left: 18px;
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #f7f4fc;
        color: #111;
        font-size: 10px;
        z-index: 2;
      }

      .drive-badge {
        position: absolute;
        right: 16px;
        bottom: 16px;
        padding: 10px 13px;
        background: rgba(17, 17, 17, 0.86);
        backdrop-filter: blur(10px);
        font-size: 9px;
        letter-spacing: 0.08em;
        border: 1px solid rgba(255, 255, 255, 0.18);
        opacity: 0;
        transform: translateY(8px);
        transition: 0.3s ease;
      }

      .project-card:hover .drive-badge {
        opacity: 1;
        transform: translateY(0);
      }

      .project-info {
        padding-top: 18px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 30px;
      }

      .project-info h3 {
        font-size: 26px;
        letter-spacing: -0.035em;
        font-weight: 500;
      }

      .project-category {
        margin-top: 7px;
        font-size: 11px;
        color: #777;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .project-description {
        max-width: 600px;
        margin-top: 15px;
        color: #aaa;
        font-size: 14px;
        line-height: 1.55;
      }

      .project-arrow {
        font-size: 27px;
        transition: transform 0.25s ease;
      }

      .project-card:hover .project-arrow {
        transform: translate(4px, -4px);
      }

      /* EXPERIENCE */

      .experience {
        padding: 150px 3vw;
        border-bottom: 1px solid #ccc;
      }

      .experience-content {
        margin-top: 65px;
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 10vw;
      }

      .experience-title h2 {
        position: sticky;
        top: 130px;
        font-size: clamp(48px, 5.6vw, 95px);
        line-height: 0.95;
        letter-spacing: -0.06em;
        font-weight: 400;
      }

      .experience-item {
        padding-bottom: 70px;
        margin-bottom: 70px;
        border-bottom: 1px solid #ccc;
      }

      .experience-item.last {
        margin-bottom: 0;
      }

      .experience-year {
        margin-bottom: 35px;
        font-size: 11px;
        letter-spacing: 0.08em;
      }

      .experience-data h3 {
        font-size: 42px;
        letter-spacing: -0.045em;
        font-weight: 500;
      }

      .experience-data > span {
        display: block;
        margin-top: 8px;
        color: #666;
        font-size: 15px;
      }

      .experience-data p {
        max-width: 700px;
        margin-top: 35px;
        font-size: 18px;
        line-height: 1.6;
      }

      .experience-data ul {
        margin-top: 30px;
        list-style: none;
      }

      .experience-data li {
        padding: 12px 0;
        border-top: 1px solid #d5d5d0;
        font-size: 14px;
        line-height: 1.4;
      }

      /* ABOUT */

      .about {
        padding: 150px 3vw 0;
        background: #f4eeff;
      }

      .about-top {
        padding-bottom: 90px;
      }

      .about-main {
        display: grid;
        grid-template-columns: 1.35fr 0.65fr;
        gap: 8vw;
        align-items: end;
      }

      .about-title h2 {
        max-width: 1050px;
        font-size: clamp(70px, 8.4vw, 145px);
        line-height: 0.84;
        letter-spacing: -0.07em;
        font-weight: 400;
      }

      .about-title em {
        display: block;
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
      }

      .about-title span {
        display: block;
      }

      .about-lead {
        font-size: clamp(22px, 2.1vw, 33px);
        line-height: 1.3;
        letter-spacing: -0.035em;
      }

      .manifesto {
        margin-top: 55px;
        padding: 24px 0;
        border-top: 1px solid rgba(0, 0, 0, 0.22);
        border-bottom: 1px solid rgba(0, 0, 0, 0.22);
      }

      .manifesto span {
        font-size: 10px;
        letter-spacing: 0.1em;
      }

      .manifesto p {
        margin-top: 18px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 25px;
        line-height: 1.25;
      }

      .about-columns {
        margin-top: 45px;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
      }

      .about-columns p {
        font-size: 14px;
        line-height: 1.65;
        color: #41433f;
      }

      .stats {
        margin-top: 120px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid rgba(0, 0, 0, 0.25);
      }

      .stat {
        min-height: 230px;
        padding: 25px 22px 30px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid rgba(0, 0, 0, 0.25);
      }

      .stat:first-child {
        padding-left: 0;
      }

      .stat:last-child {
        border-right: 0;
      }

      .stat-value {
        font-size: clamp(45px, 5vw, 80px);
        letter-spacing: -0.065em;
        line-height: 1;
      }

      .stat-label {
        max-width: 180px;
        font-size: 11px;
        line-height: 1.4;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* TOOLS */

      .tools {
        padding: 140px 3vw;
      }

      .tools-header {
        display: flex;
        justify-content: space-between;
        gap: 40px;
      }

      .tools-header p {
        max-width: 310px;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
      }

      .tools-list {
        margin-top: 70px;
        border-top: 1px solid #bbb;
      }

      .tool {
        display: grid;
        grid-template-columns: 120px 1fr;
        padding: 25px 0;
        border-bottom: 1px solid #bbb;
        font-size: clamp(30px, 4vw, 65px);
        letter-spacing: -0.045em;
      }

      .tool-number {
        padding-top: 10px;
        font-size: 11px;
        letter-spacing: 0.08em;
      }

      /* CONTACT */

      .contact {
        min-height: 85vh;
        padding: 120px 3vw 50px;
        background: #111;
        color: white;
        display: flex;
        flex-direction: column;
      }

      .contact-heading h2 {
        margin-top: 60px;
        font-size: clamp(75px, 12vw, 190px);
        line-height: 0.8;
        letter-spacing: -0.075em;
        font-weight: 400;
      }

      .contact-heading em {
        display: block;
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
      }

      .contact-bottom {
        margin-top: auto;
        padding-top: 100px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 50px;
      }

      .contact-bottom p {
        max-width: 410px;
        color: #888;
        line-height: 1.5;
      }

      .contact-links {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
